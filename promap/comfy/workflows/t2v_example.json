{
  "_promap": {
    "description": "EXAMPLE text-to-video (Wan 2.2 TI2V 5B, no source image). Same caveats as the image-to-video example.",
    "kind": "text-to-video"
  },
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    },
    "inputs": {
      "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP"
    },
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    },
    "inputs": {
      "vae_name": "wan2.2_vae.safetensors"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "promap_prompt"
    },
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "a carved pumpkin flickers with inner fire, smoke drifts, halloween night"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "promap_negative"
    },
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "blurry, low quality, watermark, text"
    }
  },
  "7": {
    "class_type": "ModelSamplingSD3",
    "_meta": {
      "title": "Model Sampling"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 8.0
    }
  },
  "8": {
    "class_type": "Wan22ImageToVideoLatent",
    "_meta": {
      "title": "promap_frames:length"
    },
    "inputs": {
      "vae": [
        "3",
        0
      ],
      "width": 832,
      "height": 480,
      "length": 49,
      "batch_size": 1
    }
  },
  "9": {
    "class_type": "KSampler",
    "_meta": {
      "title": "promap_seed"
    },
    "inputs": {
      "model": [
        "7",
        0
      ],
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "8",
        0
      ],
      "seed": 0,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    },
    "inputs": {
      "samples": [
        "9",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "11": {
    "class_type": "CreateVideo",
    "_meta": {
      "title": "promap_fps"
    },
    "inputs": {
      "images": [
        "10",
        0
      ],
      "fps": 16
    }
  },
  "12": {
    "class_type": "SaveVideo",
    "_meta": {
      "title": "promap_prefix"
    },
    "inputs": {
      "video": [
        "11",
        0
      ],
      "filename_prefix": "promap/gen",
      "format": "mp4",
      "codec": "h264"
    }
  }
}